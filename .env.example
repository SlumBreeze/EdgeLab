# Local development can leave auth disabled. Production builds default to
# required auth and fail closed if the Supabase values are missing.
VITE_AUTH_REQUIRED=false
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional when the frontend and backend are hosted separately.
VITE_BACKEND_URL=

# Legacy browser-direct integrations only. Do not set these in a deployed
# frontend; current MLB/WNBA API traffic belongs on the backend.
VITE_GEMINI_API_KEY=
VITE_ODDS_API_KEY=
